<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: keep the login cookie and Last.fm session out of cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
        <exclude domain="sharedpref" path="lastfm.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
        <exclude domain="sharedpref" path="lastfm.xml" />
    </device-transfer>
</data-extraction-rules>

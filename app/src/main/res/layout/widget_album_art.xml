<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" android:src="@drawable/ic_widget_cover" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_artwork_scrim" android:importantForAccessibility="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="18dp" android:text="@string/app_name" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" />
    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="8dp">
        <ImageButton android:id="@+id/widget_like" style="@style/WidgetButton" android:src="@drawable/ic_widget_heart" android:contentDescription="@string/widget_like" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="14dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" style="@style/WidgetTitle" android:textSize="21sp" android:maxLines="2" android:text="@string/widget_nothing_playing" />
        <TextView android:id="@+id/widget_artist" style="@style/WidgetArtist" android:text="@string/widget_open" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/widget_previous" style="@style/WidgetButton" android:src="@drawable/ic_widget_previous" android:contentDescription="@string/widget_previous" />
            <TextView android:importantForAccessibility="no" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/widget_play" android:layout_width="56dp" android:layout_height="56dp" android:padding="12dp" android:scaleType="fitCenter" android:background="@drawable/widget_play_background" android:src="@drawable/ic_widget_play" android:tint="#FF12151C" android:contentDescription="@string/widget_play" tools:ignore="UseAppTint" />
            <TextView android:importantForAccessibility="no" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/widget_next" style="@style/WidgetButton" android:src="@drawable/ic_widget_next" android:contentDescription="@string/widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Casting: finding TVs and speakers on the Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Naming a song playing nearby; only asked for when that's used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Scanning a TV's sign-in code in the app; only asked for when that's used. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Approximate only: used once to find radio stations nearby, never kept. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Downloads run as a WorkManager foreground job. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+: the playing song as a Live Update in the status bar. Granted at install. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- High performance mode asks to be left out of battery saving, so frames aren't throttled. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Taps and buzzes at the strength set in Settings. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reverb runs as an auxiliary effect on the output mix. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Local music. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- "Set as ringtone": changing the default sounds, and on Android 9 and
         older saving the ringtone's copy to shared storage. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Installing an update downloaded from GitHub Releases; Android still asks each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The phone's own equalizer, opened from the Equalizer page. -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <!-- The same app runs on Android TV, driven by the remote: nothing here is required hardware. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:banner="@drawable/tv_banner"
        android:name=".OpenTuneApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OpenTune"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity android:name=".AddonApprovalActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opentune" android:host="addon-approve" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OpenTune"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">
            <!-- Turning, folding, unfolding and resizing the window are handled by the
                 Compose UI, which picks its layout from the window's size, so pages,
                 scroll positions and the player stay as they were rather than the
                 activity starting over. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The TV home screen's row of apps. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Open YouTube Music and YouTube links: songs, playlists, albums, channels.
                 Not autoVerify: these domains aren't ours, so the user picks OpenTune. -->
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opentune" android:host="pair" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="justshivv.github.io" android:pathPrefix="/Opentune/pair/" />
            </intent-filter>
            <!-- Invites to a Listen together room: opentune://together/<code>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opentune" android:host="together" />
            </intent-filter>
            <!-- GitHub Pages cannot publish assetlinks.json at the domain root;
                 browsers use the invite landing page when Android has no default handler. -->
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="justshivv.github.io" android:pathPrefix="/Opentune/together/" />
            </intent-filter>
            <!-- "Play … on OpenTune" from the Assistant. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Shared links ("Share to OpenTune"). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- A media library: Android Auto and other media browsers can
                     browse Home, Recent and Library and search. -->
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Cover art for Android Auto, which only loads content:// artwork.
             Not exported: the browser that lists items is granted read access. -->
        <provider
            android:name=".playback.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The picture sent along when a song is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Shows OpenTune as a media app in Android Auto. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Exportify in its own screen, for "Export from Spotify". -->
        <activity
            android:name=".ui.spotify.ExportifyActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenTune"
            android:windowSoftInputMode="adjustResize" />

        <!-- Spotify's sign-in in its own screen, for Canvas. -->
        <activity
            android:name=".ui.spotify.SpotifyConnectActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenTune"
            android:windowSoftInputMode="adjustResize" />

        <!-- The home-screen widget. -->

        <receiver android:name=".widget.AlbumArtWidget" android:exported="false" android:label="@string/widget_album_art_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_album_art_info" />
        </receiver>
        <receiver android:name=".widget.StudioWidget" android:exported="false" android:label="@string/widget_studio_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_studio_info" />
        </receiver>
        <receiver
            android:name=".widget.NowPlayingWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>

        <!-- "Name that song": a home-screen widget and a Quick Settings tile. -->
        <receiver
            android:name=".widget.RecognizeWidget"
            android:exported="false"
            android:label="@string/recognize_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recognize_info" />
        </receiver>
        <service
            android:name=".widget.RecognizeTileService"
            android:exported="true"
            android:icon="@drawable/ic_recognize"
            android:label="@string/recognize_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Media buttons (the widget's, a headset's after the app was closed)
             start the player and resume the saved queue. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- The package installer's answers while an update installs. -->
        <receiver
            android:name=".data.Updater$StatusReceiver"
            android:exported="false" />

        <!-- WorkManager's foreground service, declared for the download jobs' type. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

</manifest>

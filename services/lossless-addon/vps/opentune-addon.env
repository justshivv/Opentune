# Settings for the OpenTune lossless add-on. After a change:
#   sudo systemctl restart opentune-addon

# The public address apps use.
PUBLIC_HOST=addon-opentune.rethinknow.in

# "true" turns every search and stream away (HTTP 503, paused by its owner)
# and tells apps to stay away for six hours. Manifests and sign-in still answer.
PAUSED=false

# Only devices with the official app, checked by Android hardware attestation.
VERIFICATION_MODE=strict

# SHA-256 of the certificate the official APK is signed with
# (apksigner verify --print-certs OpenTune.apk). Set for the v1.0.2 release key.
APP_CERT_SHA256=23e77142d7f0ae4d65e5e5a3dccb8e735c0042e93ffd29ab5fafe2521ab5d5a2

# The web player may pair with a phone from these sites.
WEB_ORIGINS=https://justshivv.github.io

# Requests per address per minute before HTTP 429.
REQUESTS_PER_MINUTE=240

{
  "name": "opentune-usage",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGINS": "https://justshivv.github.io" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "opentune-usage",
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID"
  }]
}
